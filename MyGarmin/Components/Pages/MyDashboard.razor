@code {

    private List<ActivityDTO> Activities { get; set; } = new();
    private bool isLoading = true;   // true od začátku, ať se hned ukáže načítání
    private string activeSort = "newest";
    private string activityType = "all";
    private List<string> activityTypeList = new();

    // filtrovaný pohled na celý seznam (Activities se nepřepisuje)
    private IEnumerable<ActivityDTO> VisibleActivities =>
        activityType == "all"
            ? Activities
            : Activities.Where(a => a.EventType == activityType);

    protected override async Task OnInitializedAsync()
    {
        await LoadAllActivitiesAsync();
        ActivityTypeList();
    }

    private async Task LoadAllActivitiesAsync()
    {
        isLoading = true;

        try
        {
            var apiKey = Configuration["Garmin:PersonalKey"]!;

            if (!string.IsNullOrEmpty(apiKey))
            {
                Activities = await GarminService.GetMyActivitiesAsync(apiKey);
            }
            else
            {
                //Logika pro to kdyz chyby api klic doplnit
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    // nastaveni druhu aktivity
    private void SetActivityType(string type)
    {
        activityType = type;
    }

    // seznam druhu aktivit
    private void ActivityTypeList()
    {
        if (Activities != null)
        {
            activityTypeList = Activities
                .Select(a => a.EventType)
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct()
                .OrderBy(t => t)
                .ToList();
        }
    }

    // od nejstaršího
    private void OrderByDateAsc()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.StartTimeLocal)
                .ToList();
            activeSort = "oldest";
        }
    }

    // od nejnovějšího
    private void OrderByDateDesc()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderByDescending(a => a.StartTimeLocal)
                .ToList();
            activeSort = "newest";
        }
    }

    // abecedne
    private void OrderByNameAlph()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.ActivityName, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            activeSort = "name";
        }
    }

    // nejrychlejší (aktivity bez rychlosti na konec)
    private void OrderByFastest()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.AverageSpeed is > 0 ? 0 : 1)
                .ThenByDescending(a => a.AverageSpeed)
                .ToList();
            activeSort = "fastest";
        }
    }

    // nejpomalejší (aktivity bez rychlosti na konec)
    private void OrderBySlowest()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.AverageSpeed is > 0 ? 0 : 1)
                .ThenBy(a => a.AverageSpeed)
                .ToList();
            activeSort = "slowest";
        }
    }

    // nejkratší (aktivity bez vzdálenosti na konec)
    private void OrderByShortest()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.Distance is > 0 ? 0 : 1)
                .ThenBy(a => a.Distance)
                .ToList();
            activeSort = "shortest";
        }
    }

    // nejdelší (aktivity bez vzdálenosti na konec)
    private void OrderByLongest()
    {
        if (Activities != null)
        {
            Activities = Activities
                .OrderBy(a => a.Distance is > 0 ? 0 : 1)
                .ThenByDescending(a => a.Distance)
                .ToList();
            activeSort = "longest";
        }
    }
}